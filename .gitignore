# ---------------------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------------------
build/
out/
cmake-build-*/
install/
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# ---------------------------------------------------------------------------
# IDEs and editors
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.user
*.suo
*.ncb
*.sln
*.vcxproj
*.vcxproj.filters

# ---------------------------------------------------------------------------
# OS metadata
# ---------------------------------------------------------------------------
desktop.ini
Thumbs.db
.DS_Store
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Caches and tooling
# ---------------------------------------------------------------------------
.cache/
.ccls-cache/
compile_commands.json
*.gcda
*.gcno
*.gcov

# ---------------------------------------------------------------------------
# Runtime state: databases, generated files and private configuration.
# Only the `*.example.json` templates are tracked; the real files hold
# deployment-specific values (and on some installs, camera credentials).
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
*.bak
core/config/config.json
core/config/license.json

# Never commit biometric data or captures.
crops/*
!crops/.gitkeep
*.jpg
*.jpeg
*.png
!docs/images/*.png
!docs/images/*.jpg

# ---------------------------------------------------------------------------
# Model weights — obtained and converted separately, see docs/MODELS.md
# ---------------------------------------------------------------------------
*.engine
*.onnx
*.etlt
*.pt
*.pth
*.trt
core/models/openvino/*.xml.hash
core/models/facedetect/tao-converter

# ---------------------------------------------------------------------------
# Media (test clips must not end up in git history)
# ---------------------------------------------------------------------------
*.avi
*.mp4
*.mpeg
*.mkv
*.mov
*.ts

# ---------------------------------------------------------------------------
# Conan generated files
# ---------------------------------------------------------------------------
conan_toolchain.cmake
conanbuild.*
conanrun.*
deactivate_conanbuild.*
deactivate_conanrun.*
conandeps_legacy.cmake
cmakedeps_macros.cmake
CMakePresets.json
CMakeUserPresets.json
*-Target-release.cmake
*-release-*-data.cmake
*-config-version.cmake
*-config.cmake
*Targets.cmake

# ---------------------------------------------------------------------------
# Non-redistributable internal packages (see conan/README.md)
# ---------------------------------------------------------------------------
conan/recipes/log-entry/
conan.tar.xz

# Python
__pycache__/
*.pyc
