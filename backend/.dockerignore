# Build artifacts (never needed inside the build context)
build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.o
*.a
*.so
*.engine

# Runtime data & user content — must never enter the image build context
attendance.db
attendance.db.bak
crops/
data/
*.log
*.log.*

# ML models are bind-mounted at runtime via docker-compose
# (./backend/core/models:/app/core/models) — keeping them out of the
# context avoids transferring ~500 MB on every build
core/models/

# VCS / IDE metadata
.git/
.github/
.idea/
.cache/
