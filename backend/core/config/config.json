{
  "models": {
    "detection_onnx": "core/models/det_500m_FP32.onnx",
    "detection_engine": "core/models/det_500m_FP32.engine",
    "recognition_onnx": "core/models/webface_r50.onnx",
    "recognition_engine": "core/models/webface_r50.engine",
    "head_onnx": "core/models/headdetection_v12.onnx",
    "head_engine": "core/models/headdetection_v12.engine"
  },
  "thresholds": {
    "detection": 0.4,
    "head": 0.6,
    "far_height": 0.036,
    "far_width": 0.017,
    "head_face_iou": 0.4
  },
  "tracker": { "track_buffer": 30,
    "track_threshold": 0.5,
    "high_threshold": 0.6,
    "match_threshold": 0.8
  },
  "motion": {
    "area_threshold": 1000,
    "buffer_frames": 5,
    "diff_threshold": 20,
    "blur_kernel_size": 5,
    "dilate_kernel_size": 5
  },
  "pipeline": {
    "embedding_queue_max_size": 128
  },
  "database": {
    "path": "attendance.db",
    "crops_dir": "data/crops"
  },
  "license": {
    "path": "core/config/license.json"
  },
  "recognition": {
    "faiss_threshold": 0.6,
    "motion_window_size": 10,
    "motion_threshold_px": 15.0
  },
  "attendance": {
    "default_arrival": "08:00",
    "default_departure": "17:00",
    "late_grace_minutes": 15
  },
  "modules": {
    "detection": {
      "enabled": true
    },
    "tracking": {
      "enabled": true,
      "motion_short_circuit": false,
      "motion_threshold": 1000,
      "motion_buffer": 5,
      "motion_diff_threshold": 20,
      "blur_kernel_size": 5,
      "dilate_kernel_size": 5
    },
    "recognition": {
      "enabled": true,
      "faiss_threshold": 0.3,
      "motion_window_size": 10,
      "motion_threshold_px": 15.0
    },
    "quality_gate": {
      "enabled": false,
      "use_blur_gate": true,
      "blur_threshold": 80.0,
      "use_side_profile_gate": true,
      "use_far_distance_gate": true,
      "far_height_threshold": 0.12,
      "far_width_threshold": 0.12
    },
    "liveness": {
      "enabled": false
    },
    "attendance": {
      "enabled": true
    }
  }
}
